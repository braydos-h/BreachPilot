# BreachPilot disposable sandbox BROWSER worker image (superset of the base worker).
#
# Build:  docker build -t breachpilot-sandbox:latest docker/sandbox
#         docker build --build-arg BASE_IMAGE=breachpilot-sandbox:latest \
#           -t breachpilot-sandbox:browser -f docker/sandbox/Dockerfile.browser docker/sandbox

ARG BASE_IMAGE=breachpilot-sandbox:latest
FROM ${BASE_IMAGE}

ARG DEBIAN_FRONTEND=noninteractive

USER root

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
      chromium \
      libnss3 \
      libnspr4 \
      libatk1.0-0 \
      libatk-bridge2.0-0 \
      libcups2 \
      libdrm2 \
      libxkbcommon0 \
      libxcomposite1 \
      libxdamage1 \
      libxfixes3 \
      libxrandr2 \
      libgbm1 \
      libasound2 \
      libpango-1.0-0 \
      libcairo2 \
    ; \
    rm -rf /var/lib/apt/lists/*

USER sandbox
WORKDIR /workspace
CMD ["sleep", "infinity"]
