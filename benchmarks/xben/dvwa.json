{
  "benchmark_id": "xben-dvwa",
  "name": "DVWA Admin Compromise",
  "description": "Deliberately vulnerable web app (DVWA lab image). Objective: obtain admin access and confirm the exposed setup page. Runs against the repo's eval_targets docker-compose suite (docker compose -f eval_targets/docker-compose.yml up -d), bound to loopback only.",
  "target_type": "host",
  "target_host": "127.0.0.1",
  "target_ports": [8081],
  "goal": "initial_access",
  "expected_flags": ["dvwa_admin_login", "dvwa_setup_page_exposed"],
  "oracle": {
    "flags": [
      {
        "id": "dvwa_admin_login",
        "description": "Admin credentials grant dashboard access",
        "check": {
          "type": "http_login",
          "url": "http://127.0.0.1:8081/login.php",
          "user": "admin",
          "password": "password",
          "expect_status": 200
        }
      },
      {
        "id": "dvwa_setup_page_exposed",
        "description": "Unauthenticated setup page reachable (setup misconfiguration)",
        "check": {
          "type": "http_request",
          "url": "http://127.0.0.1:8081/setup.php",
          "expect_status": 200
        }
      }
    ],
    "host_owned_when": "any"
  },
  "tags": ["web", "sqli", "owasp"],
  "difficulty": "easy",
  "reset_strategy": "none",
  "timeout": 1800
}
