/** Textual CSS theme for the AI Bug Bounty Research Agent TUI.

Layout: Header | Sidebar(28) | Content(1fr) | Footer
Colors: green=safe, yellow=warning, red=danger, blue=info, purple=accent
*/

/* ── Base ───────────────────────────────────────────────────────────────── */

Screen {
    background: $surface;
    color: $text;
}

Header {
    dock: top;
    height: 1;
    background: $panel;
    color: $text;
    text-style: bold;
}

/* ── Main layout ────────────────────────────────────────────────────────── */

#main-layout {
    height: 1fr;
}

#sidebar-container {
    width: 28;
    background: $surface-darken-1;
    border-right: solid $primary-background;
    height: 1fr;
}

#sidebar-mission {
    height: 4;
    padding: 1 2;
    background: $surface-darken-2;
    border-bottom: solid $primary-background;
}

#sidebar {
    height: 1fr;
    background: transparent;
}

#sidebar ListItem {
    padding: 0 2;
    background: transparent;
    color: $text-muted;
}

#sidebar ListItem:hover {
    background: $accent 15%;
    color: $text;
}

#sidebar ListItem.--highlight {
    background: $accent 30%;
    color: $text;
    text-style: bold;
}

/* ── Content area ───────────────────────────────────────────────────────── */

#content-container {
    width: 1fr;
    height: 1fr;
    background: $surface;
}

/* ── Footer ────────────────────────────────────────────────────────────── */

#status-footer {
    dock: bottom;
    height: 1;
    background: $surface-darken-1;
    padding: 0 1;
}

/* ── Dashboard grid ─────────────────────────────────────────────────────── */

#dash-grid {
    layout: grid;
    grid-size: 3 3;
    grid-gutter: 1;
    padding: 1;
    height: 1fr;
}

#dash-grid Vertical {
    border: solid $primary-background;
    padding: 1;
}

#dash-mission, #dash-scope, #dash-tasks,
#dash-findings, #dash-next, #dash-recent, #dash-swarm {
    height: 1fr;
}

.card-title {
    text-style: bold;
    padding-bottom: 1;
    border-bottom: solid $primary-background;
}

/* ── DataTable ──────────────────────────────────────────────────────────── */

DataTable {
    height: 1fr;
    background: $surface;
}

DataTable > .datatable--header {
    background: $surface-darken-1;
    text-style: bold;
    color: $text;
}

DataTable > .datatable--cursor {
    background: $accent 20%;
}

/* ── Filter bars ────────────────────────────────────────────────────────── */

#tasks-filter, #findings-filter, #ev-filter,
#mem-filter, #logs-filter {
    height: 3;
    padding: 1;
    background: $surface-darken-1;
}

#tasks-filter Select, #findings-filter Select,
#ev-filter Select, #mem-filter Select,
#logs-filter Select {
    width: 24;
}

#tasks-filter Input, #mem-filter Input {
    width: 30;
}

/* ── Scope screen ───────────────────────────────────────────────────────── */

#scope-tester-row {
    height: 3;
    padding: 1;
}

#scope-tester-input {
    width: 40;
}

#scope-tables {
    height: 14;
}

#scope-allow-table, #scope-deny-table {
    width: 1fr;
}

/* ── Task detail ────────────────────────────────────────────────────────── */

#task-detail-body {
    height: 1fr;
    padding: 2;
}

#task-detail-actions {
    height: 3;
    align: center bottom;
}

/* ── Execution ──────────────────────────────────────────────────────────── */

#exec-body {
    height: 1fr;
    padding: 2;
}

#exec-actions {
    height: 3;
    align: center bottom;
}

/* ── Finding detail ─────────────────────────────────────────────────────── */

#fd-body {
    height: 1fr;
    padding: 2;
}

#fd-actions {
    height: 3;
    align: center bottom;
}

/* ── Evidence detail ────────────────────────────────────────────────────── */

#ev-detail-content {
    padding: 2;
    height: 1fr;
}

/* ── Wizard ──────────────────────────────────────────────────────────────── */

#wiz-steps {
    width: 28;
    height: 1fr;
    background: $surface-darken-1;
    padding: 1 2;
    border-right: solid $primary-background;
}

#wiz-content {
    width: 1fr;
    height: 1fr;
    padding: 2;
}

#wiz-nav {
    height: 3;
    padding: 1;
    background: $surface-darken-1;
    align: center middle;
}

#wiz-step-indicator {
    width: 1fr;
    text-align: center;
}

/* ── Graph ───────────────────────────────────────────────────────────────── */

#graph-tree {
    height: 1fr;
    padding: 2;
}

#graph-stats {
    height: 1;
    background: $surface-darken-1;
    padding: 0 2;
}

/* ── Help ───────────────────────────────────────────────────────────────── */

#help-content {
    padding: 2;
    height: 1fr;
}

/* ── Settings ────────────────────────────────────────────────────────────── */

#settings-body {
    height: 1fr;
    padding: 2;
}

#settings-body Input {
    width: 50;
}

#settings-actions-container {
    height: 3;
    align: center bottom;
}

/* ── Status labels ────────────────────────────────────────────────────────── */

#sidebar-mission {
    text-align: center;
}

/* ── Swarm screen ────────────────────────────────────────────────────────── */

#swarm-summary-bar {
    height: 1;
    background: $surface-darken-1;
    padding: 0 1;
}

#swarm-grid {
    layout: grid;
    grid-size: 2 2;
    grid-gutter: 1;
    padding: 1;
    height: 1fr;
}

#swarm-agents-panel, #swarm-blackboard-panel, #swarm-battle-log-panel {
    border: solid $primary-background;
    padding: 1;
    height: 1fr;
}

#swarm-agents-panel {
    row-span: 2;
}

#swarm-battle-log-panel {
    col-span: 1;
}

/* ── Misc ────────────────────────────────────────────────────────────────── */

Label {
    padding: 0 1;
}

#tasks-counts, #findings-count, #ev-count,
#mem-count, #logs-count, #rpt-count {
    height: 1;
    padding: 0 2;
    background: $surface-darken-2;
}

Button {
    margin: 0 1;
}

#wiz-create {
    margin-left: 2;
}

ScrollableContainer {
    height: 1fr;
}

/* ── Empty states ───────────────────────────────────────────────────────── */

#empty-message {
    text-align: center;
    padding: 3 0;
}

#empty-hint {
    text-align: center;
}
